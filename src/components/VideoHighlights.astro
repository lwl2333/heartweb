---
---

<section class="video-section" id="videos">
  <div class="container">
    <div class="section-header text-center fade-in">
      <span class="section-tag">Memories in Motion</span>
      <h2>Our Video Highlights</h2>
      <p class="section-description">Relive our most cherished moments</p>
    </div>

    <!-- Upload Area -->
    <div class="video-upload-area fade-in" id="video-upload-area">
      <div class="upload-content">
        <svg class="upload-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
        <p class="upload-title">Add Video Memories</p>
        <p class="upload-hint">Drag & drop videos here, or click to browse</p>
        <p class="upload-formats">Supports: MP4, WebM, MOV (Max 100MB)</p>
        <input type="file" id="video-file-input" multiple accept="video/*" />
        <button class="btn btn-outline upload-btn" id="video-upload-btn">Choose Files</button>
      </div>
    </div>

    <!-- Video Grid -->
    <div class="video-grid" id="video-grid">
      <!-- Videos will be injected here -->
    </div>
  </div>
</section>

<!-- Toast Notification -->
<div class="video-toast" id="video-toast"></div>

<style is:global>
  .video-section {
    padding: var(--space-2xl) 0;
    background: var(--bg-warm);
  }

  /* Reuse section header styles from global/gallery if possible, 
     but defining here ensures self-containment if they aren't global */
  
  /* ===== Upload Area (Matching Gallery) ===== */
  .video-upload-area {
    border: 2px dashed var(--color-primary-light);
    border-radius: var(--radius-md);
    padding: var(--space-xl) var(--space-md);
    text-align: center;
    margin-bottom: var(--space-xl);
    background: rgba(255, 255, 255, 0.6);
    transition: all var(--transition-base);
    cursor: pointer;
    position: relative;
  }

  .video-upload-area:hover,
  .video-upload-area.drag-over {
    border-color: var(--color-primary);
    background: rgba(255, 245, 245, 0.9);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .video-upload-area.drag-over {
    border-style: solid;
  }

  .video-upload-area .upload-icon {
    color: var(--color-primary-light);
    margin-bottom: var(--space-sm);
    transition: color var(--transition-base);
  }

  .video-upload-area:hover .upload-icon,
  .video-upload-area.drag-over .upload-icon {
    color: var(--color-primary);
  }

  .video-upload-area .upload-title {
    font-family: var(--font-handwriting);
    font-size: 1.5rem;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .video-upload-area .upload-hint {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 0.25rem;
  }

  .video-upload-area .upload-formats {
    font-size: 0.8rem;
    color: var(--text-light);
    margin-bottom: var(--space-sm);
  }

  .video-upload-area input[type="file"] {
    display: none;
  }

  /* ===== Video Grid ===== */
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* 2 columns on desktop */
    gap: var(--space-md);
    width: 100%;
  }

  .video-item {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: white;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
    aspect-ratio: 16 / 9;
    cursor: pointer;
  }

  .video-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .video-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Mute/Unmute Overlay */
  .video-mute-overlay {
    position: absolute;
    bottom: var(--space-sm);
    right: var(--space-sm);
    background: rgba(0, 0, 0, 0.6);
    border-radius: 50%;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    opacity: 0;
    transition: opacity var(--transition-fast);
    pointer-events: none; /* Let clicks pass through to the video container */
  }

  .video-item:hover .video-mute-overlay {
    opacity: 1;
  }
  
  /* Show state when unmuted regardless of hover, or maybe just on hover? 
     User requirement: "toggle mute/unmute (show a mute/unmute icon overlay)"
     I'll make it always visible on mobile, hover on desktop usually, but for clarity let's keep it simple.
  */

  /* Delete Button */
  .video-delete-btn {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    width: 32px;
    height: 32px;
    background: rgba(220, 53, 69, 0.9);
    color: white;
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.8);
    transition: all var(--transition-fast);
    z-index: 10;
  }

  .video-item:hover .video-delete-btn {
    opacity: 1;
    transform: scale(1);
  }

  .video-delete-btn:hover {
    background: #dc3545;
    transform: scale(1.1) !important;
  }

  /* ===== Toast ===== */
  .video-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background: var(--text-primary);
    color: white;
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    z-index: 3000;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
    white-space: nowrap;
  }

  .video-toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .video-grid {
      grid-template-columns: 1fr; /* 1 column on mobile */
    }

    .video-upload-area {
      padding: var(--space-lg) var(--space-sm);
    }
    
    .video-mute-overlay {
      opacity: 1; /* Always show on touch devices where hover isn't reliable */
    }
    
    .video-delete-btn {
      opacity: 1; /* Always show delete on mobile */
      transform: scale(1);
    }
  }
</style>

<script>
  // ==================== IndexedDB Helpers ====================
  const DB_NAME = 'heartweb-videos';
  const DB_VERSION = 1;
  const STORE_NAME = 'videos';

  function openVideoDB(): Promise<IDBDatabase> {
    return new Promise((resolve, reject) => {
      const request = indexedDB.open(DB_NAME, DB_VERSION);
      
      request.onupgradeneeded = (event) => {
        const db = request.result;
        if (!db.objectStoreNames.contains(STORE_NAME)) {
          db.createObjectStore(STORE_NAME, { keyPath: 'id', autoIncrement: true });
        }
      };

      request.onsuccess = () => resolve(request.result);
      request.onerror = () => reject(request.error);
    });
  }

  interface VideoRecord {
    id?: number;
    blob: Blob;
    name: string;
    caption: string;
    addedAt: number;
  }

  async function videoDbSave(record: VideoRecord): Promise<number> {
    const db = await openVideoDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_NAME, 'readwrite');
      const store = tx.objectStore(STORE_NAME);
      const req = store.add(record);
      req.onsuccess = () => resolve(req.result as number);
      req.onerror = () => reject(req.error);
    });
  }

  async function videoDbGetAll(): Promise<VideoRecord[]> {
    const db = await openVideoDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_NAME, 'readonly');
      const store = tx.objectStore(STORE_NAME);
      const req = store.getAll();
      req.onsuccess = () => resolve(req.result);
      req.onerror = () => reject(req.error);
    });
  }

  async function videoDbDelete(id: number): Promise<void> {
    const db = await openVideoDB();
    return new Promise((resolve, reject) => {
      const tx = db.transaction(STORE_NAME, 'readwrite');
      const store = tx.objectStore(STORE_NAME);
      const req = store.delete(id);
      req.onsuccess = () => resolve();
      req.onerror = () => reject(req.error);
    });
  }

  // ==================== Config ====================
  const MAX_VIDEO_SIZE = 100 * 1024 * 1024; // 100MB
  const ALLOWED_VIDEO_TYPES = ['video/mp4', 'video/webm', 'video/quicktime'];

  // ==================== DOM References ====================
  const uploadArea = document.getElementById('video-upload-area');
  const fileInput = document.getElementById('video-file-input') as HTMLInputElement;
  const uploadBtn = document.getElementById('video-upload-btn');
  const videoGrid = document.getElementById('video-grid');
  const toastEl = document.getElementById('video-toast');

  // ==================== Toast ====================
  let toastTimer: ReturnType<typeof setTimeout> | null = null;

  function showVideoToast(message: string) {
    if (!toastEl) return;
    toastEl.textContent = message;
    toastEl.classList.add('show');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toastEl.classList.remove('show');
    }, 3000);
  }

  // ==================== Video Rendering ====================
  function createVideoItem(blobUrl: string, name: string, dbId: number): HTMLElement {
    const item = document.createElement('div');
    item.className = 'video-item fade-in';
    
    // Video element
    const video = document.createElement('video');
    video.src = blobUrl;
    video.loop = true;
    video.autoplay = true;
    video.muted = true;
    video.playsInline = true;
    
    // Mute overlay icon
    const muteOverlay = document.createElement('div');
    muteOverlay.className = 'video-mute-overlay';
    // Start with muted icon since it's muted by default
    muteOverlay.innerHTML = getMuteIcon();
    
    // Delete button
    const deleteBtn = document.createElement('button');
    deleteBtn.className = 'video-delete-btn';
    deleteBtn.title = 'Delete video';
    deleteBtn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>`;
    
    // Toggle mute on click
    item.addEventListener('click', (e) => {
      // Don't toggle if clicked on delete button
      if ((e.target as HTMLElement).closest('.video-delete-btn')) return;
      
      video.muted = !video.muted;
      muteOverlay.innerHTML = video.muted ? getMuteIcon() : getUnmuteIcon();
    });

    // Delete action
    deleteBtn.addEventListener('click', async (e) => {
      e.stopPropagation();
      if (confirm('Delete this video memory?')) {
        try {
          await videoDbDelete(dbId);
          item.style.transform = 'scale(0.8)';
          item.style.opacity = '0';
          setTimeout(() => {
            item.remove();
            URL.revokeObjectURL(blobUrl); // Cleanup
          }, 300);
          showVideoToast('Video removed');
        } catch (err) {
          console.error('Delete failed:', err);
          showVideoToast('Failed to delete video');
        }
      }
    });

    item.appendChild(video);
    item.appendChild(muteOverlay);
    item.appendChild(deleteBtn);
    
    return item;
  }

  function getMuteIcon() {
    return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5L6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>`;
  }

  function getUnmuteIcon() {
    return `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>`;
  }

  // ==================== File Handling ====================
  function validateVideo(file: File): string | null {
    if (!ALLOWED_VIDEO_TYPES.some(type => file.type.startsWith('video/') || file.type === type)) {
      return `"${file.name}" is not a supported video format`;
    }
    if (file.size > MAX_VIDEO_SIZE) {
      return `"${file.name}" exceeds 100MB limit`;
    }
    return null;
  }

  async function handleVideoFiles(files: FileList | File[]) {
    let successCount = 0;
    const errorMessages: string[] = [];

    for (const file of Array.from(files)) {
      const error = validateVideo(file);
      if (error) {
        errorMessages.push(error);
        continue;
      }

      try {
        const record: VideoRecord = {
          blob: file,
          name: file.name,
          caption: file.name.replace(/\.[^.]+$/, ''),
          addedAt: Date.now()
        };

        const dbId = await videoDbSave(record);
        const blobUrl = URL.createObjectURL(file);
        const element = createVideoItem(blobUrl, record.name, dbId);
        
        // Prepend to grid
        if (videoGrid && videoGrid.firstChild) {
            videoGrid.insertBefore(element, videoGrid.firstChild);
        } else {
            videoGrid?.appendChild(element);
        }

        // Animate
        requestAnimationFrame(() => {
          element.classList.add('visible');
        });

        successCount++;
      } catch (err) {
        console.error('Save failed:', err);
        errorMessages.push(`Failed to save "${file.name}"`);
      }
    }

    if (successCount > 0) {
      showVideoToast(`Added ${successCount} video${successCount === 1 ? '' : 's'}`);
    }
    if (errorMessages.length > 0) {
      setTimeout(() => showVideoToast(errorMessages[0]), successCount > 0 ? 3200 : 0);
    }
  }

  // ==================== Init & Events ====================
  async function init() {
    // Load saved videos
    try {
      const videos = await videoDbGetAll();
      // Sort by addedAt desc (newest first)
      videos.sort((a, b) => b.addedAt - a.addedAt);
      
      for (const video of videos) {
        const blobUrl = URL.createObjectURL(video.blob);
        const element = createVideoItem(blobUrl, video.name, video.id!);
        videoGrid?.appendChild(element);
        requestAnimationFrame(() => element.classList.add('visible'));
      }
    } catch (err) {
      console.error('Init failed:', err);
    }

    // Events
    uploadBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput?.click();
    });

    uploadArea?.addEventListener('click', (e) => {
      if (e.target === uploadBtn) return;
      fileInput?.click();
    });

    fileInput?.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleVideoFiles(fileInput.files);
        fileInput.value = '';
      }
    });

    // Drag & Drop
    uploadArea?.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('drag-over');
    });

    uploadArea?.addEventListener('dragleave', () => {
      uploadArea.classList.remove('drag-over');
    });

    uploadArea?.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('drag-over');
      const files = (e as DragEvent).dataTransfer?.files;
      if (files && files.length > 0) {
        handleVideoFiles(files);
      }
    });
  }

  // Run init
  init();

</script>
